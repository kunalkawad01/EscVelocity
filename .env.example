# MarketDNA — root env file consumed by docker-compose.yml.
#
# Copy to `.env` (already gitignored) and fill in real values before `docker compose up -d --build`.
#
# This file feeds TWO things:
#   1. docker compose's own ${VAR} substitution in docker-compose.yml (the postgres service's
#      POSTGRES_USER/PASSWORD/DB mapping) — compose auto-loads .env from the same directory as
#      docker-compose.yml for this purpose, regardless of any env_file: directive.
#   2. The backend container's process environment, via `env_file: .env` on the backend service
#      in docker-compose.yml — these land in os.environ before app/main.py's own
#      load_dotenv(marketdna-backend/.env) call runs, and python-dotenv defaults to
#      override=False, so these values win either way.
#
# Kite credentials (KITE_API_KEY / KITE_API_SECRET / KITE_ACCESS_TOKEN) are NOT here — they live
# in marketdna-data/.env instead, because app/services/kite_client.py's dotenv_values() and
# ingestion/kite/client.py's load_dotenv() both read that physical file directly, bypassing
# container env vars entirely. See ops/daily-post-market.sh for the daily token-refresh routine.

# ── PostgreSQL (consumed by: backend via MARKETDNA_PG_* / app/db.py; the postgres container
#    itself via POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB mapped from these same values) ──────
MARKETDNA_PG_HOST=postgres
MARKETDNA_PG_PORT=5432
MARKETDNA_PG_DB=marketdna
MARKETDNA_PG_USER=marketdna
MARKETDNA_PG_PASSWORD=changeme

# ── CORS (consumed by: backend, app/main.py CORSMiddleware) ─────────────────────────────────────
# Same-origin deployment via Caddy makes this a no-op for normal prod traffic (frontend calls
# relative /api/... paths), but set it to your real domain for defensiveness.
MARKETDNA_CORS_ORIGINS=["https://marketdna.yourdomain.com"]

# ── AI Research Copilot (consumed by: backend, api.anthropic.com) ───────────────────────────────
# Blank = "Describe in plain English" portfolio authoring / AI Research Copilot returns 502;
# rest of the app is unaffected.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ── F&O Tactical AI Desk chat panel (consumed by: backend, OpenAI-compatible reseller) ──────────
AICREDIT_API_KEY=
AICREDIT_BASE_URL=
AICREDIT_MODEL=
# RESEARCH_MODEL=
