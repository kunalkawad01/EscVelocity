# MarketDNA — Kite Connect credentials.
#
# Copy to `.env` (already gitignored) and fill in real values.
#
# This is a PHYSICAL FILE read directly by:
#   - marketdna-backend/app/services/kite_client.py, via dotenv_values(settings.data_path / ".env")
#   - ingestion/kite/client.py (via marketdna-data/config/settings.py's bare load_dotenv())
# Both bypass container/process env vars entirely — docker-compose `environment:`/`env_file:`
# directives do NOT reach this code path. See ../ops/daily-post-market.sh for the daily
# token-refresh routine (edits this file's KITE_ACCESS_TOKEN line in place, then restarts the
# backend container so its @lru_cache'd Kite client re-reads it).
#
# The access token expires daily and must be refreshed every morning after logging into Kite.

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
